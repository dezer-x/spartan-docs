{
  "openapi": "3.1.0",
  "info": {
    "title": "DezerX — Products",
    "version": "1.0.0",
    "description": "Read-only access to the product catalogue.\n\n**Base URL:** `https://example.com/api/application`\n\n**Authentication:** `Authorization: Bearer <api_token>`\n\n### Permissions required\n| Endpoint | Permission |\n|---|---|\n| `GET /products` | `products.index` |\n| `GET /products/{id}` | `products.show` |"
  },
  "servers": [
    {
      "url": "https://example.com/api/application",
      "description": "Application API (replace example.com with your domain)"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationApiToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CategorySummary": {
        "type": "object",
        "properties": {
          "id":   { "type": "integer", "example": 2 },
          "name": { "type": "string",  "example": "VPS Hosting" }
        }
      },
      "ProductFull": {
        "type": "object",
        "properties": {
          "id":            { "type": "integer", "example": 3 },
          "name":          { "type": "string",  "example": "Starter VPS" },
          "slug":          { "type": "string",  "example": "starter-vps" },
          "description":   { "type": "string",  "nullable": true },
          "status":        { "type": "string",  "example": "active" },
          "category_id":   { "type": "integer", "example": 2 },
          "position":      { "type": "integer", "example": 1 },
          "image":         { "type": "string",  "nullable": true },
          "stock":         { "type": "integer", "nullable": true, "description": "null = unlimited" },
          "per_user_stock":{ "type": "integer", "nullable": true },
          "module":        { "type": "string",  "nullable": true, "example": "PterodactylService" },
          "module_config": {
            "type": "object",
            "nullable": true,
            "description": "Module-specific configuration (e.g. node ID, egg ID for Pterodactyl)"
          },
          "duration_config": {
            "type": "object",
            "nullable": true,
            "description": "Keyed by billing cycle. Each entry: `{ \"enabled\": true, \"price\": 9.99, \"setup_fee\": 0 }`",
            "example": {
              "monthly":  { "enabled": true,  "price": 9.99,  "setup_fee": 0 },
              "yearly":   { "enabled": true,  "price": 99.99, "setup_fee": 0 },
              "lifetime": { "enabled": false, "price": 0,     "setup_fee": 0 }
            }
          },
          "custom_plans": {
            "type": "array",
            "nullable": true,
            "description": "Admin-defined billing plans with arbitrary interval/period",
            "items": {
              "type": "object",
              "properties": {
                "id":        { "type": "string",  "example": "custom_abc123" },
                "name":      { "type": "string",  "example": "6-month plan" },
                "interval":  { "type": "integer", "example": 6 },
                "period":    { "type": "string",  "example": "month", "enum": ["day","week","month","year"] },
                "price":     { "type": "number",  "example": 54.99 },
                "setup_fee": { "type": "number",  "example": 0 },
                "enabled":   { "type": "boolean", "example": true }
              }
            }
          },
          "enable_upgrade":              { "type": "boolean" },
          "enable_downgrade":            { "type": "boolean" },
          "allow_balance_auto_renewal":  { "type": "boolean" },
          "upgrade_fee":                 { "type": "string", "nullable": true, "example": "5.00" },
          "downgrade_fee":               { "type": "string", "nullable": true, "example": "0.00" },
          "upgrade_prorate":             { "type": "boolean" },
          "downgrade_refund":            { "type": "boolean" },
          "free_trial_enabled":          { "type": "boolean" },
          "free_trial_duration":         { "type": "integer", "nullable": true, "example": 7 },
          "free_trial_price":            { "type": "string", "nullable": true, "example": "0.00" },
          "create_service_before_payment":{ "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "category": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/CategorySummary" }]
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page":   { "type": "integer", "example": 1 },
          "from":           { "type": "integer", "example": 1, "nullable": true },
          "last_page":      { "type": "integer", "example": 3 },
          "per_page":       { "type": "integer", "example": 15 },
          "to":             { "type": "integer", "example": 15, "nullable": true },
          "total":          { "type": "integer", "example": 42 },
          "path":           { "type": "string" },
          "first_page_url": { "type": "string" },
          "last_page_url":  { "type": "string" },
          "next_page_url":  { "type": "string", "nullable": true },
          "prev_page_url":  { "type": "string", "nullable": true },
          "links":          { "type": "array", "items": { "type": "object" } }
        }
      },
      "Error401": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Error403": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Error404": { "type": "object", "properties": { "success": { "type": "boolean", "example": false }, "message": { "type": "string", "example": "Product not found" } } }
    }
  },
  "paths": {
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List all products",
        "description": "Returns a paginated list of products ordered by `position` (ascending). Each item includes a `category` object with `id` and `name`.\n\n**Required permission:** `products.index`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 15 } },
          { "name": "search",   "in": "query", "schema": { "type": "string" }, "description": "Filter by product name (LIKE %search%)" },
          { "name": "page",     "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated product list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "allOf": [
                        { "$ref": "#/components/schemas/PaginationMeta" },
                        { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/ProductFull" } } } }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get a specific product",
        "description": "Returns a single product with its `category` relationship loaded.\n\n**Required permission:** `products.show`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 3 }
        ],
        "responses": {
          "200": {
            "description": "Product found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data":    { "$ref": "#/components/schemas/ProductFull" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": { "description": "Product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    }
  }
}
