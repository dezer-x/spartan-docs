{
  "openapi": "3.1.0",
  "info": {
    "title": "DezerX — Users",
    "version": "1.0.0",
    "description": "CRUD operations on user accounts.\n\n**Base URL:** `https://example.com/api/application`\n\n**Authentication:** `Authorization: Bearer <api_token>`\n\n### Permissions required per endpoint\n| Endpoint | Permission |\n|---|---|\n| `GET /users` | `users.index` |\n| `GET /users/{id}` | `users.show` |\n| `POST /users` | `users.create` |\n| `PUT /users/{id}` | `users.update` |\n| `PATCH /users/{id}/role` | `users.update` |\n| `DELETE /users/{id}` | `users.destroy` |"
  },
  "servers": [
    {
      "url": "https://example.com/api/application",
      "description": "Application API (replace example.com with your domain)"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationApiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Active API token from the admin panel. Token must have the required permission for each endpoint."
      }
    },
    "schemas": {
      "AdminRoleMinimal": {
        "type": "object",
        "properties": {
          "name":         { "type": "string", "example": "admin" },
          "display_name": { "type": "string", "example": "Administrator" }
        }
      },
      "ServiceSummary": {
        "type": "object",
        "properties": {
          "id":                   { "type": "integer", "example": 7 },
          "service_name":         { "type": "string", "nullable": true },
          "product_id":           { "type": "integer", "nullable": true },
          "category_id":          { "type": "integer", "nullable": true },
          "owner_id":             { "type": "integer", "example": 42 },
          "price":                { "type": "string", "example": "9.99" },
          "billing_cycle":        { "type": "string", "example": "monthly" },
          "status":               { "type": "string", "enum": ["pending", "active", "suspended", "terminated"] },
          "due_date":             { "type": "string", "format": "date-time", "nullable": true },
          "module":               { "type": "string", "nullable": true },
          "auto_renewal_enabled": { "type": "boolean" },
          "created_at":           { "type": "string", "format": "date-time" },
          "updated_at":           { "type": "string", "format": "date-time" }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id":                { "type": "integer", "example": 42 },
          "name":              { "type": "string", "example": "Jane Doe" },
          "email":             { "type": "string", "format": "email", "example": "jane@example.com" },
          "avatar":            { "type": "string", "nullable": true, "example": "/storage/avatars/jane.png" },
          "role":              { "type": "string", "nullable": true, "example": "admin" },
          "email_verified_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at":        { "type": "string", "format": "date-time" },
          "discord_id":        { "type": "string", "nullable": true },
          "google_id":         { "type": "string", "nullable": true },
          "github_id":         { "type": "string", "nullable": true },
          "admin_role": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/AdminRoleMinimal" }]
          }
        }
      },
      "UserFull": {
        "allOf": [
          { "$ref": "#/components/schemas/UserSummary" },
          {
            "type": "object",
            "properties": {
              "balance":               { "type": "string", "example": "25.00" },
              "loyalty_points":        { "type": "integer", "example": 0 },
              "is_suspended":          { "type": "boolean", "example": false },
              "suspension_reason":     { "type": "string", "nullable": true },
              "suspended_by":          { "type": "string", "nullable": true },
              "suspended_at":          { "type": "string", "format": "date-time", "nullable": true },
              "suspension_expires_at": { "type": "string", "format": "date-time", "nullable": true },
              "google2fa_enabled":     { "type": "boolean", "example": false },
              "stripe_id":             { "type": "string", "nullable": true },
              "updated_at":            { "type": "string", "format": "date-time" },
              "services": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ServiceSummary" }
              }
            }
          }
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page":   { "type": "integer", "example": 1 },
          "from":           { "type": "integer", "example": 1, "nullable": true },
          "last_page":      { "type": "integer", "example": 5 },
          "per_page":       { "type": "integer", "example": 15 },
          "to":             { "type": "integer", "example": 15, "nullable": true },
          "total":          { "type": "integer", "example": 75 },
          "path":           { "type": "string", "example": "https://example.com/api/application/users" },
          "first_page_url": { "type": "string" },
          "last_page_url":  { "type": "string" },
          "next_page_url":  { "type": "string", "nullable": true },
          "prev_page_url":  { "type": "string", "nullable": true },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url":    { "type": "string", "nullable": true },
                "label":  { "type": "string" },
                "active": { "type": "boolean" }
              }
            }
          }
        }
      },
      "Error401": {
        "type": "object",
        "properties": {
          "error":   { "type": "string", "example": "Unauthorized" },
          "message": { "type": "string" }
        }
      },
      "Error403": {
        "type": "object",
        "properties": {
          "error":   { "type": "string", "example": "Forbidden" },
          "message": { "type": "string" }
        }
      },
      "Error404": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "User not found" }
        }
      },
      "Error422": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Validation failed" },
          "errors": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "string" } },
            "example": { "email": ["The email field is required.", "The email has already been taken."] }
          }
        }
      },
      "Error500": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List all users",
        "description": "Returns a paginated list of users. Columns `discord_id`, `google_id`, and `github_id` are only included if the corresponding OAuth module columns exist in the database.\n\n**Required permission:** `users.index`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "schema": { "type": "integer", "default": 15 },
            "description": "Number of results per page"
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by name or email (LIKE %search%)"
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated user list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "allOf": [
                        { "$ref": "#/components/schemas/PaginationMeta" },
                        {
                          "type": "object",
                          "properties": {
                            "data": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/UserSummary" }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error401" },
                "examples": {
                  "missing_bearer": { "value": { "error": "Unauthorized", "message": "Bearer token required" } },
                  "invalid_token":  { "value": { "error": "Unauthorized", "message": "Invalid or inactive token" } }
                }
              }
            }
          },
          "403": {
            "description": "IP not allowed or insufficient permissions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error403" },
                "examples": {
                  "ip_denied":           { "value": { "error": "Forbidden", "message": "Access denied from this IP address" } },
                  "insufficient_perms":  { "value": { "error": "Forbidden", "message": "Insufficient permissions for this action" } }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a user",
        "description": "Registers a new user. Optionally assigns an admin role by name.\n\n**Required permission:** `users.create`",
        "security": [{ "ApplicationApiToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name":     { "type": "string", "maxLength": 255, "example": "Jane Doe" },
                  "email":    { "type": "string", "format": "email", "example": "jane@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "s3cr3tPass!" },
                  "role": {
                    "type": "string",
                    "description": "Must match an existing `admin_roles.name` value",
                    "example": "moderator"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "User created successfully" },
                    "data":    { "$ref": "#/components/schemas/UserFull" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } }
          },
          "403": {
            "description": "IP not allowed or insufficient permissions",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } }
          },
          "422": {
            "description": "Validation failed (e.g. email already taken)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error422" } } }
          },
          "500": {
            "description": "Internal error during registration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error500" },
                "example": { "success": false, "message": "Error creating user: <detail>" }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a specific user",
        "description": "Returns a single user with `adminRole` and `services` relationships loaded.\n\n**Required permission:** `users.show`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 42 }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data":    { "$ref": "#/components/schemas/UserFull" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error404" },
                "example": { "success": false, "message": "User not found" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update a user",
        "description": "Partially updates the user. All fields are optional — only supplied fields are changed. Sending `password` will hash it before storing.\n\n**Required permission:** `users.update`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 42 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name":     { "type": "string", "maxLength": 255 },
                  "email":    { "type": "string", "format": "email" },
                  "role":     { "type": "string", "description": "Must match an existing admin_roles.name" },
                  "password": { "type": "string", "minLength": 8 }
                }
              },
              "example": { "name": "Jane Smith", "email": "janesmith@example.com" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "User updated successfully" },
                    "data":    { "$ref": "#/components/schemas/UserFull" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": { "description": "User not found",  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } },
          "422": { "description": "Validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error422" } } } }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user",
        "description": "Hard-deletes the user record.\n\n**Required permission:** `users.destroy`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 42 }
        ],
        "responses": {
          "200": {
            "description": "User deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "User deleted successfully" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": { "description": "User not found",  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    },
    "/users/{id}/role": {
      "patch": {
        "tags": ["Users"],
        "summary": "Update user role (alias)",
        "description": "Alias for `PUT /users/{id}`. Accepts the same body. Typically used to change only the `role` field.\n\n**Required permission:** `users.update`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 42 }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name":     { "type": "string" },
                  "email":    { "type": "string", "format": "email" },
                  "role":     { "type": "string" },
                  "password": { "type": "string", "minLength": 8 }
                }
              },
              "example": { "role": "moderator" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "User updated successfully" },
                    "data":    { "$ref": "#/components/schemas/UserFull" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": { "description": "User not found",  "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } },
          "422": { "description": "Validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error422" } } } }
        }
      }
    }
  }
}
