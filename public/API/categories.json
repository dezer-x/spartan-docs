{
  "openapi": "3.1.0",
  "info": {
    "title": "DezerX — Categories",
    "version": "1.0.0",
    "description": "Read-only access to product categories.\n\n**Base URL:** `https://example.com/api/application`\n\n**Authentication:** `Authorization: Bearer <api_token>`\n\n### Permissions required\n| Endpoint | Permission |\n|---|---|\n| `GET /categories` | `categories.index` |\n| `GET /categories/{id}` | `categories.show` |"
  },
  "servers": [
    {
      "url": "https://example.com/api/application",
      "description": "Application API (replace example.com with your domain)"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationApiToken": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "ProductSummary": {
        "type": "object",
        "properties": {
          "id":        { "type": "integer", "example": 3 },
          "name":      { "type": "string",  "example": "Starter VPS" },
          "slug":      { "type": "string",  "example": "starter-vps" },
          "status":    { "type": "string",  "example": "active" },
          "position":  { "type": "integer", "example": 1 },
          "image":     { "type": "string",  "nullable": true }
        }
      },
      "CategoryFull": {
        "type": "object",
        "properties": {
          "id":             { "type": "integer", "example": 2 },
          "name":           { "type": "string",  "example": "VPS Hosting" },
          "description":    { "type": "string",  "nullable": true },
          "image":          { "type": "string",  "nullable": true },
          "position":       { "type": "integer", "example": 1 },
          "products_count": { "type": "integer", "example": 5, "description": "Included on list endpoint only" },
          "products": {
            "type": "array",
            "description": "Included on detail endpoint only",
            "items": { "$ref": "#/components/schemas/ProductSummary" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page":   { "type": "integer", "example": 1 },
          "from":           { "type": "integer", "example": 1, "nullable": true },
          "last_page":      { "type": "integer", "example": 2 },
          "per_page":       { "type": "integer", "example": 15 },
          "to":             { "type": "integer", "example": 15, "nullable": true },
          "total":          { "type": "integer", "example": 20 },
          "path":           { "type": "string" },
          "first_page_url": { "type": "string" },
          "last_page_url":  { "type": "string" },
          "next_page_url":  { "type": "string", "nullable": true },
          "prev_page_url":  { "type": "string", "nullable": true },
          "links":          { "type": "array", "items": { "type": "object" } }
        }
      },
      "Error401": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Error403": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Error404": { "type": "object", "properties": { "success": { "type": "boolean", "example": false }, "message": { "type": "string", "example": "Category not found" } } }
    }
  },
  "paths": {
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "List all categories",
        "description": "Returns a paginated list of categories ordered by `position` (ascending). Each item includes a `products_count` aggregate.\n\n**Required permission:** `categories.index`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 15 } },
          { "name": "search",   "in": "query", "schema": { "type": "string" }, "description": "Filter by category name (LIKE %search%)" },
          { "name": "page",     "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated category list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "allOf": [
                        { "$ref": "#/components/schemas/PaginationMeta" },
                        { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/CategoryFull" } } } }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "tags": ["Categories"],
        "summary": "Get a specific category",
        "description": "Returns a single category with its `products` relationship loaded (all products in this category).\n\n**Required permission:** `categories.show`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 2 }
        ],
        "responses": {
          "200": {
            "description": "Category found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data":    { "$ref": "#/components/schemas/CategoryFull" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": { "description": "Category not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    }
  }
}
