{
  "openapi": "3.1.0",
  "info": {
    "title": "DezerX — Token",
    "version": "1.0.0",
    "description": "Introspect the currently authenticated Application API token.\n\n**Base URL:** `https://example.com/api/application`\n\n**Authentication:** `Authorization: Bearer <api_token>`"
  },
  "servers": [
    {
      "url": "https://example.com/api/application",
      "description": "Application API (replace example.com with your domain)"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationApiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An active API token generated from the admin panel (`/admin/api`). The calling IP must be on the token's allow-list if one is configured."
      }
    },
    "schemas": {
      "Error401": {
        "type": "object",
        "properties": {
          "error":   { "type": "string", "example": "Unauthorized" },
          "message": { "type": "string", "example": "Bearer token required" }
        }
      },
      "Error403": {
        "type": "object",
        "properties": {
          "error":   { "type": "string", "example": "Forbidden" },
          "message": { "type": "string", "example": "Access denied from this IP address" }
        }
      }
    }
  },
  "paths": {
    "/token/info": {
      "get": {
        "tags": ["Token"],
        "summary": "Get current API token info",
        "description": "Returns metadata about the authenticated API token. No extra permission beyond a valid bearer token is required.",
        "security": [{ "ApplicationApiToken": [] }],
        "responses": {
          "200": {
            "description": "Token info returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "name":        { "type": "string",  "example": "My Integration Token" },
                        "permissions": {
                          "type": "object",
                          "nullable": true,
                          "description": "Nested permission map keyed by category, then permission key",
                          "example": {
                            "user_management": ["users.index", "users.show"],
                            "service_management": ["services.index", "services.show"]
                          }
                        },
                        "last_used_at": { "type": "string", "format": "date-time", "nullable": true, "example": "2026-02-25T10:30:00Z" },
                        "created_at":   { "type": "string", "format": "date-time", "example": "2026-01-01T00:00:00Z" }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "name": "My Integration Token",
                    "permissions": {
                      "user_management": ["users.index", "users.show"],
                      "service_management": ["services.index"]
                    },
                    "last_used_at": "2026-02-25T10:30:00Z",
                    "created_at": "2026-01-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error401" },
                "examples": {
                  "missing_bearer": {
                    "value": { "error": "Unauthorized", "message": "Bearer token required" }
                  },
                  "invalid_token": {
                    "value": { "error": "Unauthorized", "message": "Invalid or inactive token" }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Calling IP is not on the token allow-list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error403" },
                "example": { "error": "Forbidden", "message": "Access denied from this IP address" }
              }
            }
          }
        }
      }
    }
  }
}
