{
  "openapi": "3.1.0",
  "info": {
    "title": "DezerX — Coupons",
    "version": "1.0.0",
    "description": "Read-only access to discount coupons and their usage history.\n\n**Base URL:** `https://example.com/api/application`\n\n**Authentication:** `Authorization: Bearer <api_token>`\n\n### Permissions required\n| Endpoint | Permission |\n|---|---|\n| `GET /coupons` | `coupons.index` |\n| `GET /coupons/{id}` | `coupons.show` |"
  },
  "servers": [
    {
      "url": "https://example.com/api/application",
      "description": "Application API (replace example.com with your domain)"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApplicationApiToken": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "CouponUse": {
        "type": "object",
        "properties": {
          "id":         { "type": "integer" },
          "coupon_id":  { "type": "integer" },
          "user_id":    { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "user": {
            "nullable": true,
            "type": "object",
            "properties": {
              "id":    { "type": "integer" },
              "name":  { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          }
        }
      },
      "CouponSummary": {
        "type": "object",
        "properties": {
          "id":                   { "type": "integer",  "example": 5 },
          "code":                 { "type": "string",   "example": "SAVE20" },
          "name":                 { "type": "string",   "example": "20% off VPS" },
          "description":          { "type": "string",   "nullable": true },
          "type":                 { "type": "string",   "enum": ["percentage","fixed"], "example": "percentage" },
          "value":                { "type": "string",   "example": "20.00", "description": "Percentage (0–100) or fixed amount" },
          "usage_limit":          { "type": "integer",  "nullable": true, "description": "null = unlimited" },
          "used_count":           { "type": "integer",  "example": 3 },
          "coupon_uses_count":    { "type": "integer",  "example": 3, "description": "Eager-loaded aggregate" },
          "one_time_use":         { "type": "boolean",  "example": false },
          "new_users_only":       { "type": "boolean",  "example": false },
          "new_users_scope":      { "type": "string",   "nullable": true, "enum": ["any","product","category"] },
          "is_lifetime":          { "type": "boolean",  "example": false, "description": "If true the discount applies on every renewal" },
          "expires_at":           { "type": "string",   "format": "date-time", "nullable": true },
          "status":               { "type": "string",   "enum": ["active","expired","inactive"] },
          "allowed_billing_cycles":{ "type": "array",   "nullable": true, "items": { "type": "string" }, "example": ["monthly","yearly"] },
          "target_product_id":    { "type": "integer",  "nullable": true },
          "target_category_id":   { "type": "integer",  "nullable": true },
          "target_product_ids":   { "type": "array",    "nullable": true, "items": { "type": "integer" } },
          "target_category_ids":  { "type": "array",    "nullable": true, "items": { "type": "integer" } },
          "target_product": {
            "nullable": true,
            "type": "object",
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
          },
          "target_category": {
            "nullable": true,
            "type": "object",
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CouponFull": {
        "allOf": [
          { "$ref": "#/components/schemas/CouponSummary" },
          {
            "type": "object",
            "properties": {
              "coupon_uses": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/CouponUse" }
              }
            }
          }
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page":   { "type": "integer", "example": 1 },
          "from":           { "type": "integer", "nullable": true },
          "last_page":      { "type": "integer" },
          "per_page":       { "type": "integer", "example": 15 },
          "to":             { "type": "integer", "nullable": true },
          "total":          { "type": "integer" },
          "path":           { "type": "string" },
          "first_page_url": { "type": "string" },
          "last_page_url":  { "type": "string" },
          "next_page_url":  { "type": "string", "nullable": true },
          "prev_page_url":  { "type": "string", "nullable": true },
          "links":          { "type": "array",  "items": { "type": "object" } }
        }
      },
      "Error401": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Error403": { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } } },
      "Error404": { "type": "object", "properties": { "success": { "type": "boolean", "example": false }, "message": { "type": "string", "example": "Coupon not found" } } }
    }
  },
  "paths": {
    "/coupons": {
      "get": {
        "tags": ["Coupons"],
        "summary": "List all coupons",
        "description": "Returns a paginated list of coupons with `targetProduct` (id, name), `targetCategory` (id, name), and a `coupon_uses_count` aggregate.\n\n**Required permission:** `coupons.index`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 15 } },
          { "name": "search",   "in": "query", "schema": { "type": "string" }, "description": "Filter by coupon name or code (LIKE %search%)" },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["active","expired","inactive"] }
          },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "Paginated coupon list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "allOf": [
                        { "$ref": "#/components/schemas/PaginationMeta" },
                        { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/CouponSummary" } } } }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } }
        }
      }
    },
    "/coupons/{id}": {
      "get": {
        "tags": ["Coupons"],
        "summary": "Get a specific coupon",
        "description": "Returns a single coupon with `targetProduct`, `targetCategory`, `couponUses.user` relationships loaded, plus `coupon_uses_count`.\n\n**Required permission:** `coupons.show`",
        "security": [{ "ApplicationApiToken": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 5 }
        ],
        "responses": {
          "200": {
            "description": "Coupon found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data":    { "$ref": "#/components/schemas/CouponFull" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error401" } } } },
          "403": { "description": "Forbidden",       "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error403" } } } },
          "404": { "description": "Coupon not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error404" } } } }
        }
      }
    }
  }
}
